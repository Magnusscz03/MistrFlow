{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/owner-ai",
      "destination": "https://dxpzqepbkkhcbpqmnokn.supabase.co/functions/v1/owner-ai"
    },
    {
      "source": "/supabase/functions/v1/:path*",
      "destination": "https://dxpzqepbkkhcbpqmnokn.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/tarify",
      "destination": "/tarify/index.html"
    },
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/intake",
      "destination": "/intake/index.html"
    },
    {
      "source": "/soukromi",
      "destination": "/soukromi/index.html"
    },
    {
      "source": "/auth/confirmed",
      "destination": "/auth/confirmed/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "node scripts/verify-deploy.mjs",
  "installCommand": "",
  "redirects": [
    {
      "source": "/intake/:token",
      "destination": "/intake?token=:token",
      "permanent": false
    }
  ]
}
